# Copy to .env (server + web). NEVER commit real secrets.
# Server
PORT=4000
JWT_SECRET=change-me-to-32-plus-random-chars
# Database — Supabase Postgres (only backend).
# Supabase Dashboard → Project Settings → Database → Connection string (URI):
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
# Optional alias:
# SUPABASE_DB_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
SHOP_TIMEZONE=Asia/Kolkata
SHOP_CURRENCY=INR
RATE_STALE_MINUTES=120
BILLING_BLOCK_ON_STALE=false
# Email (Google SMTP). Create a 16-char Google "App password" for the account.
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-shop@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=Shree Gold Palace
# Set MAIL_DISABLED=true to suppress all outbound email (used by tests).
MAIL_DISABLED=false
# Web (Vite — must start with VITE_)
VITE_API_URL=http://localhost:4000/api
